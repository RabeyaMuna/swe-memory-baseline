# ============================================================================
# WORKSPACE & OUTPUT PATHS (Supports relative and absolute paths)
# ============================================================================

# Base directory for all benchmark artifacts (supports env vars and ~ expansion)
# Default: {REPO_ROOT}/artifacts if unset
BENCHMARK_WORK_DIR=./artifacts
BENCHMARK_OUTPUT_DIR=${BENCHMARK_WORK_DIR}/ci_repair_split
MEMORY_BANK_DIR=${BENCHMARK_OUTPUT_DIR}

# ============================================================================
# CI REPAIR BENCHMARK DATASET
# ============================================================================

# HuggingFace dataset for CI repair benchmark
CI_BENCHMARK_DATASET=ci-benchmark-user/ci-repair-bench
CI_BENCHMARK_SPLIT=train

# Repository preset: core_ci_repair or custom list
CI_REPAIR_REPO_PRESET=core_ci_repair

# Memory partition: seed ratio (0.0-1.0) and minimum per repo
CI_MEMORY_SEED_RATIO=0.3
CI_MIN_MEMORY_PER_REPO=5

# ============================================================================
# MEMORY CONFIGURATION (Hierarchical 3-Level Retrieval)
# ============================================================================

# Memory mode: baseline (no memory) or memory (with retrieval)
MEMORY_MODE=memory

# Ablation: L1 only | L1+L2 combined | L1+L2+L3 (full)
MEMORY_ABLATION_LEVELS=L1+L2+L3

# Top-K candidates at L1 level
MEMORY_TOP_K=3

# Memory level thresholds (can override auto-computed values)
# L1: 0.30 | L2: 0.40 | L3: 0.50 | Global: 0.33 (for L1+L2+L3)
# MEMORY_L1_THRESHOLD=0.30
# MEMORY_L2_THRESHOLD=0.40
# MEMORY_L3_THRESHOLD=0.50
# MEMORY_SIMILARITY_THRESHOLD=0.33

# ============================================================================
# LLM API KEYS & ENDPOINTS
# ============================================================================

# MiniMax (primary, via OpenRouter)
MINIMAX_API_KEY=sk-or-v1-your-openrouter-key
MINIMAX_BASE_URL=https://openrouter.ai/api/v1
MEMCI_LLM_MODEL=MiniMax-M2.5

# LiteLLM universal config (used by benchmark if MINIMAX not set)
LITELLM_API_KEY=${MINIMAX_API_KEY}
LITELLM_API_BASE=

# OpenAI (fallback)
OPENAI_API_KEY=${MINIMAX_API_KEY}
OPENAI_API_BASE=https://api.openai.com/v1

# OpenRouter (fallback alternative)
OPENROUTER_API_KEY=${MINIMAX_API_KEY}

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================

# Model for analyzing CI artifacts (logs + workflow YAML)
CI_ARTIFACT_ANALYSIS_MODEL=openrouter/minimax/minimax-m2.5

# Model for SWE-agent repairs
AGENT_MODEL=openrouter/minimax/minimax-m2.5

# ============================================================================
# SWE-AGENT CONFIGURATION
# ============================================================================

# Config root for relative path resolution
SWE_AGENT_CONFIG_ROOT=.

# Deployment: local or docker
DEPLOYMENT_TYPE=local
DEPLOYMENT_IMAGE=python:3.11

# Agent execution limits
SWE_AGENT_MAX_STEPS=30
SWE_AGENT_MAX_TOKENS=4000

# ============================================================================
# CI ANALYSIS CONFIGURATION
# ============================================================================

# Analysis mode: heuristic (rule-based) or llm (model-based)
CI_ANALYSIS_MODE=heuristic

# Max chars from CI logs to analyze
CI_MAX_LOG_CHARS=12000

# ============================================================================
# LOGGING & DEBUG
# ============================================================================

LOG_LEVEL=INFO
DEBUG_MEMORY_RETRIEVAL=false
KEEP_TEMP_FILES=false

# ============================================================================
# SYSTEM COMPATIBILITY
# ============================================================================

# CI/CD mode (disable interactive prompts)
CI_MODE=true

# Temp directory (leave empty for system default)
TEMP_DIR=
